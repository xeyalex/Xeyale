CREATE TABLE IF NOT EXISTS expense_plans (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    budget DECIMAL(10, 2) NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    user_id BIGINT,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

